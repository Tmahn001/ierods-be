DATABASE_URL=postgresql://postgres:password@localhost:5432/ierods
POLL_INTERVAL_SEC=30
HEARTBEAT_TIMEOUT_SEC=90
MANUAL_RECOVERY_BASELINE_MIN=40
BATCH_READY_THRESHOLD=10
FRONTEND_ORIGIN=http://localhost:3000
# Dev only: stand in for the ping service so stations do not all "die" 90s after
# their first heartbeat. Set to false in production and run pinger.py instead.
HEARTBEAT_SIMULATE=true
